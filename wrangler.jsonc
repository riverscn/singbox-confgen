// Cloudflare Workers deployment: an assets-only Worker serving the Vite build in dist/.
// Cloudflare Workers Builds runs `npm run build` and deploys: main to production, every other
// branch as a Preview.
{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "singbox-confgen",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./dist",
    // Single page: anything that isn't a file gets index.html.
    "not_found_handling": "single-page-application"
  },
  "workers_dev": true,
  "preview_urls": true,
  // Required by `wrangler preview`, which Workers Builds runs for non-main branches; empty means
  // a Preview uses the settings above.
  "previews": {}
}
