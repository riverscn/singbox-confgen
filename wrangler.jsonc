// Cloudflare Workers deployment: an assets-only Worker serving the Vite build in dist/.
// Cloudflare Workers Builds runs `npm run build` and deploys: main to production, every other
// branch as a Preview.
{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "singbox-confgen",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./dist",
    // Paths that aren't files are a plain 404, not index.html: the app has no client-side routes,
    // and serving the page at every path would make search engines see duplicates of it.
    "not_found_handling": "none"
  },
  // Production is served only on the custom domain, so search engines don't see a second copy at
  // *.workers.dev. Preview URLs are set explicitly: they would otherwise follow workers_dev.
  "workers_dev": false,
  "preview_urls": true,
  // Required by `wrangler preview`, which Workers Builds runs for non-main branches; empty means
  // a Preview uses the settings above.
  "previews": {}
}
